      <item>
       <widget class="QPushButton" name="btn_batal">
        <property name="styleSheet">
         <string notr="true">QPushButton#btn_batal {
                                        height: 44px; /* h-11 */
                                        padding: 0 24px; /* px-6 */
                                        border: 1px solid;
                                        border-radius: 8px; /* rounded-lg */
                                        background: rgba(229,231,235,0.8); /* bg-gray-200/80
                                        */
                                        color: rgb(31,41,55); /* text-gray-800 */
                                        font-size: 12pt; /* text-sm */
                                        font-weight: 600; /* font-semibold */
                                        }

                                        /* Hover */
                                        QPushButton#btn_batal:hover {
                                        background: rgba(209,213,219,0.8); /*
                                        hover:bg-gray-300/80 */
                                        }

                                        /* Dark mode (Qt tidak punya otomatis, jadi harus
                                        manual) */
                                        /* Biasanya diganti via setStyleSheet() ketika mode
                                        gelap aktif */
                                        QPushButton#btn_batal.dark {
                                        background: rgba(55,65,81,0.5); /*
                                        dark:bg-gray-700/50 */
                                        color: rgb(229,231,235); /* dark:text-gray-200 */
                                        }

                                        QPushButton#btn_batal.dark:hover {
                                        background: rgba(75,85,99,0.5); /*
                                        dark:hover:bg-gray-600/50 */
                                        }</string>
        </property>
        <property name="text">
         <string>Batal</string>
        </property>
       </widget>
      </item>
      <item>
       <widget class="QPushButton" name="btn_simpan">
        <property name="styleSheet">
         <string notr="true">QPushButton#btn_simpan {
                                        height: 44px; /* h-11 */
                                        padding: 0 24px; /* px-6 */
                                        border: 1px solid;
                                        border-radius: 8px; /* rounded-lg */
                                        background: rgb(25, 230, 94); /* bg-primary → pilih
                                        warna sendiri */
                                        color: black; /* text-black */
                                        font-size: 12pt; /* text-sm */
                                        font-weight: 600; /* font-semibold */
                                        }

                                        /* QSS TIDAK BISA scale transform di hover */
                                        QPushButton#btn_simpan:hover {
                                        /* workarounds */
                                        padding: 0 26px; /* buat seolah-olah membesar */
                                        }

                                        /* active:scale-95 → tidak ada, jadi manual */
                                        QPushButton#btn_simpan:pressed {
                                        padding: 0 22px;
                                        }</string>
        </property>
        <property name="text">
         <string>Simpan</string>
        </property>
       </widget>
      </item>
